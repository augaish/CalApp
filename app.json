{
  "expo": {
    "name": "Calgym",
    "slug": "calapp",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5712e171-778c-472d-8681-debf40460713"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "com.augaish.calapp",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.augaish.calapp",
      "adaptiveIcon": {
        "backgroundColor": "#ECE7F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": {
        "CFBundleDisplayName": "Calgym",
        "NSCameraUsageDescription": "Calgym uses the camera to analyze your meals and gym equipment."
      },
      "ar": {
        "CFBundleDisplayName": "\u0643\u0627\u0644\u062c\u064a\u0645",
        "NSCameraUsageDescription": "\u064a\u0633\u062a\u062e\u062f\u0645 \u0643\u0627\u0644\u062c\u064a\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0644\u062a\u062d\u0644\u064a\u0644 \u0648\u062c\u0628\u0627\u062a\u0643 \u0648\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0646\u0627\u062f\u064a."
      }
    },
    "plugins": [
      "./plugins/withAndroidLintFix",
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Calgym uses the camera to analyze your meals and gym equipment."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Calgym uses your photos to analyze meals and gym equipment you've already photographed."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6D5AAB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5712e171-778c-472d-8681-debf40460713"
      }
    },
    "owner": "augaishb"
  }
}
