{
  "expo": {
    "name": "Calgym",
    "slug": "calapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "com.augaish.calapp",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.augaish.calapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": {
        "CFBundleDisplayName": "Calgym",
        "NSCameraUsageDescription": "Calgym uses the camera to analyze your meals and gym equipment."
      },
      "ar": {
        "CFBundleDisplayName": "كالجيم",
        "NSCameraUsageDescription": "يستخدم كالجيم الكاميرا لتحليل وجباتك وأجهزة النادي."
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Calgym uses the camera to analyze your meals and gym equipment."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10B981",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5712e171-778c-472d-8681-debf40460713"
      }
    },
    "owner": "augaishb"
  }
}
