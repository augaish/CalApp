# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the vision model (default: claude-haiku-4-5-20251001 — cheapest)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: server port (default 3000)
# PORT=3000

# Optional: Postgres connection string to enable the shared equipment cache.
# On Railway, adding a Postgres plugin provides this automatically as
# ${{ Postgres.DATABASE_URL }}. Leave unset to run without caching.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
